/* ═══ base ═══════════════════════════════════════════════════════ */

.wf {
  font-family: var(--wf-font);
  font-size: var(--t-md); line-height: var(--t-md-lh);
  color: var(--w-ink1); background: var(--w-canvas);
}
.wf * { box-sizing: border-box; }
.wf button, .wf input, .wf textarea, .wf select { font: inherit; color: inherit; }
.wf button { cursor: pointer; background: none; border: none; padding: 0; }

/* ═══ typography ═════════════════════════════════════════════════ */

.wf .t-display { font-size: var(--t-2xl); line-height: var(--t-2xl-lh); font-weight: 700; }
.wf .t-title   { font-size: var(--t-xl);  line-height: var(--t-xl-lh);  font-weight: 700; }
.wf .t-heading { font-size: var(--t-lg);  line-height: var(--t-lg-lh);  font-weight: 600; }
.wf .t-body    { font-size: var(--t-md);  line-height: var(--t-md-lh);  font-weight: 400; }
.wf .t-body-strong { font-size: var(--t-md); line-height: var(--t-md-lh); font-weight: 600; }
.wf .t-small   { font-size: var(--t-sm);  line-height: var(--t-sm-lh);  font-weight: 400; }
.wf .t-caption { font-size: var(--t-xs);  line-height: var(--t-xs-lh);  font-weight: 400; }
.wf .muted     { color: var(--w-ink2); }

/* ═══ glyphs — drawn functional icons (currentColor) ═════════════ */

.wf .glyph { display: inline-block; flex-shrink: 0;
  width: var(--ic-md); height: var(--ic-md);
  background: currentColor;
  -webkit-mask: center / contain no-repeat; mask: center / contain no-repeat; }
.wf .glyph-sm { width: var(--ic-sm); height: var(--ic-sm); }
.wf .glyph-lg { width: var(--ic-lg); height: var(--ic-lg); }
.wf .gl-chevron    { -webkit-mask-image: var(--gl-chevron);    mask-image: var(--gl-chevron); }
.wf .gl-search     { -webkit-mask-image: var(--gl-search);     mask-image: var(--gl-search); }
.wf .gl-check      { -webkit-mask-image: var(--gl-check);      mask-image: var(--gl-check); }
.wf .gl-x          { -webkit-mask-image: var(--gl-x);          mask-image: var(--gl-x); }
.wf .gl-plus       { -webkit-mask-image: var(--gl-plus);       mask-image: var(--gl-plus); }
.wf .gl-bell       { -webkit-mask-image: var(--gl-bell);       mask-image: var(--gl-bell); }
.wf .gl-camera     { -webkit-mask-image: var(--gl-camera);     mask-image: var(--gl-camera); }
.wf .gl-alert      { -webkit-mask-image: var(--gl-alert);      mask-image: var(--gl-alert); }
.wf .gl-arrow-left { -webkit-mask-image: var(--gl-arrow-left); mask-image: var(--gl-arrow-left); }
.wf .gl-info       { -webkit-mask-image: var(--gl-info);       mask-image: var(--gl-info); }

/* placeholder for app-specific icons not yet decided */
.wf .icon { display: inline-block; flex-shrink: 0;
  width: var(--ic-lg); height: var(--ic-lg); border-radius: var(--r-full);
  background: var(--w-surface); border: 1px solid var(--w-border); }
.wf .icon-sm { width: var(--ic-sm); height: var(--ic-sm); }
.wf .icon-md { width: var(--ic-md); height: var(--ic-md); }
.wf .icon-xl { width: var(--ic-xl); height: var(--ic-xl); }

/* ═══ buttons — 3 styles × 3 sizes ═══════════════════════════════ */

.wf .btn {
  display: inline-flex; align-items: center; justify-content: center;
  gap: var(--sp-2); border-radius: var(--r-md); font-weight: 600;
  height: var(--h-md); padding: 0 var(--sp-3);
  font-size: var(--t-md); line-height: var(--t-md-lh);
  transition: opacity 120ms, background 120ms;
}
.wf .btn-sm { height: var(--h-sm); padding: 0 var(--sp-2);
  font-size: var(--t-sm); line-height: var(--t-sm-lh); }
.wf .btn-lg { height: var(--h-lg); padding: 0 var(--sp-5); }

.wf .btn-primary { background: var(--w-accent); color: var(--w-on-accent); }
.wf .btn-primary:hover { opacity: 0.88; }
.wf .btn-primary:active { opacity: 0.75; }

.wf .btn-secondary { border: 1px solid var(--w-border); }
.wf .btn-secondary:hover { background: var(--w-surface); }
.wf .btn-secondary:active { background: var(--w-border); }

.wf .btn-ghost { color: var(--w-ink1); }
.wf .btn-ghost:hover { background: var(--w-surface); }
.wf .btn-ghost:active { background: var(--w-border); }

.wf .btn:disabled { opacity: 0.4; cursor: not-allowed; }
.wf .btn:focus-visible, .wf .chip:focus-visible, .wf .tab:focus-visible,
.wf .btn-icon:focus-visible, .wf .switch:focus-visible {
  outline: 2px solid var(--w-accent); outline-offset: 2px; }
.wf .btn-block { display: flex; width: 100%; }

/* icon-only button — must carry an aria-label */
.wf .btn-icon {
