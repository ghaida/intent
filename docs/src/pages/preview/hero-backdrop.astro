---
// TEMPORARY: test the HeroBackdrop component in real hero context.
// /intent's geometry rendered in light grey at rest; cursor reveals ink locally.

import Base from '../../layouts/Base.astro';
import HeroBackdrop from '../../components/visuals/HeroBackdrop.astro';
import { loadSkills } from '../../lib/skills';

const skills = loadSkills();
const raw = import.meta.env.BASE_URL;
const base = raw.endsWith('/') ? raw : raw + '/';
---

<Base title="Hero backdrop — Intent (preview)" description="Light-grey backdrop using /intent geometry, cursor-revealed.">
  <div class="page">
    <header class="hero-backdrop-preview__head">
      <p class="mono small muted">Internal preview · backdrop</p>
      <h1>Light-grey backdrop, cursor reveals</h1>
      <p class="muted">
        The /intent score's composition in light grey at rest. Move your
        cursor — within a soft radius the marks darken to ink. Otherwise
        the composition stays subdued.
      </p>
    </header>

    <section class="hero hero--backdrop">
      <HeroBackdrop />
      <div class="hero-content">
        <h2>Design with <span class="hero-accent">Intent</span></h2>
        <p class="hero-lede subtext">
          A UX strategy system for AI tools. {skills.length} skills covering research,
          strategy, flows, content, accessibility, ethics, and measurement.
        </p>
        <div class="hero-how-to-use">
          <a href={`${base}how-to-use/`} class="hero-how-to-use-btn">See Intent in action</a>
          <span class="hero-how-to-use-desc muted">Follow a project from first question to engineering handoff</span>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero-backdrop-preview__head {
    max-width: 70ch;
    padding: 48px 0 16px;
  }

  .hero-backdrop-preview__head h1 {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    margin: 12px 0;
  }

  .hero--backdrop {
    position: relative;
    margin: 32px 0;
    padding: 120px 0;
    border-top: 1px solid var(--border);
    overflow: hidden;
    min-height: 600px;
    isolation: isolate;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: 0 var(--page-pad);
  }

  .hero-content h2 {
    font-family: var(--display);
    font-weight: 700;
    font-size: clamp(2.3rem, 6vw, 4.5rem);
    letter-spacing: -0.03em;
    margin: 0 0 24px;
    max-width: 14ch;
  }

  .hero-content .hero-accent { color: var(--accent); }

  .hero-lede {
    color: var(--fg-muted);
    margin: 0 0 32px;
    max-width: 55ch;
  }
</style>
