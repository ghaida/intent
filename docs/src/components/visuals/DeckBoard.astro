              <div class="visual" role="img" aria-label="Table of pilot targets: 15 or more exchanges per 1,000 households per week after three months, 60% of listings ending in an exchange, median under 48 hours from listing to pickup, 25% or more of listings free, and under 10% of accepted interests ghosted. Time in app, notification opens, GMV and DAU/MAU are refused as targets.">
                <table class="deck-table">
                  <thead><tr><th>Target</th><th>Measure</th></tr></thead>
                  <tbody>
                    <tr><td class="strong">15+ per week</td><td>Completed exchanges per 1,000 households, after 3 months</td></tr>
                    <tr><td class="strong">60%</td><td>Listings that end in an exchange</td></tr>
                    <tr><td class="strong">Under 48 hours</td><td>Median time from listing to pickup</td></tr>
                    <tr><td class="strong">25%+</td><td>Listings given away free</td></tr>
                    <tr><td class="strong">Under 10%</td><td>Accepted interests that never get picked up</td></tr>
                    <tr class="refused"><td>Refused</td><td>Time in app, notification opens, GMV, DAU/MAU</td></tr>
                  </tbody>
                </table>
