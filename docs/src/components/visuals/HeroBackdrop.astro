---
// Hero backdrop — light grey at rest, cursor reveals a slightly darker grey
// locally. Composition adapted from /intent: vectors radiating from a center
// to terminal points AT the viewBox edges, plus a sparse center field.
// preserveAspectRatio="none" lets the SVG stretch to fill the viewport
// exactly — terminals always land at the browser-window edges.
---

<svg
  class="hero-backdrop"
  viewBox="0 0 1200 800"
  preserveAspectRatio="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <defs>
    <radialGradient id="hero-backdrop-pool" cx="50%" cy="50%" r="50%">
      <stop offset="0%"   stop-color="white" stop-opacity="1"/>
      <stop offset="55%"  stop-color="white" stop-opacity="0.55"/>
      <stop offset="100%" stop-color="white" stop-opacity="0"/>
    </radialGradient>
    <mask id="hero-backdrop-mask">
      <rect width="100%" height="100%" fill="black"/>
      <circle class="hero-backdrop__pool" cx="-400" cy="-400" r="320"
              fill="url(#hero-backdrop-pool)"/>
    </mask>

    <!-- Reusable composition: vectors from center to viewBox-edge terminals -->
    <g id="hero-backdrop-marks">
      <!-- Sparse center field -->
      <g fill="currentColor" stroke="none">
        <circle cx="540" cy="360" r="2"/>
        <circle cx="612" cy="384" r="2"/>
        <circle cx="668" cy="412" r="2"/>
        <circle cx="556" cy="436" r="2"/>
        <circle cx="640" cy="464" r="2"/>
      </g>
      <!-- 6 radiating vectors from center to corners and edge midpoints -->
      <g fill="none" stroke="currentColor" stroke-width="1.5"
         vector-effect="non-scaling-stroke">
        <line x1="600" y1="400" x2="0"    y2="100"/>
        <line x1="600" y1="400" x2="600"  y2="0"/>
        <line x1="600" y1="400" x2="1200" y2="100"/>
        <line x1="600" y1="400" x2="1200" y2="700"/>
        <line x1="600" y1="400" x2="600"  y2="800"/>
        <line x1="600" y1="400" x2="0"    y2="700"/>
      </g>
      <!-- Terminal points at the viewBox edges -->
      <g fill="currentColor" stroke="none">
        <circle cx="0"    cy="100" r="5"/>
        <circle cx="600"  cy="0"   r="5"/>
        <circle cx="1200" cy="100" r="5"/>
        <circle cx="1200" cy="700" r="5"/>
        <circle cx="600"  cy="800" r="5"/>
        <circle cx="0"    cy="700" r="5"/>
      </g>
    </g>
  </defs>

  <!-- Layer 1: composition in light grey at rest -->
  <g class="hero-backdrop__resting">
    <use href="#hero-backdrop-marks"/>
  </g>

  <!-- Layer 2: same composition slightly darker, revealed inside the cursor pool -->
  <g class="hero-backdrop__lit" mask="url(#hero-backdrop-mask)">
    <use href="#hero-backdrop-marks"/>
  </g>
</svg>

<style>
  /* Full-bleed: fills the viewport width exactly. preserveAspectRatio="none"
     stretches the viewBox to match the SVG box, so terminals at viewBox edges
     land at the browser window edges. */
  .hero-backdrop {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .hero-backdrop__resting {
    color: var(--border);
    opacity: 0.45;
  }

  .hero-backdrop__lit {
    color: var(--blueprint-mark);
    opacity: 0.55;
  }
</style>

<script is:inline>
  (function() {
    document.querySelectorAll('.hero-backdrop').forEach((svg) => {
      const pool = svg.querySelector('.hero-backdrop__pool');
      const hero = svg.closest('.hero, .hero--mark, .hero--archetype, .hero--sig, .hero--v5, .hero--backdrop') || svg.parentElement;
      if (!pool || !hero) return;

      const vbW = 1200, vbH = 800;
      // Park off-screen at start
      let targetX = -400, targetY = -400;
      let currentX = -400, currentY = -400;
      let active = false;

      // Convert viewport-relative pointer coordinates into viewBox space.
      // With preserveAspectRatio="none", X and Y stretch independently.
      function setTargetFromEvent(ev) {
        const rect = svg.getBoundingClientRect();
        targetX = ((ev.clientX - rect.left) / rect.width) * vbW;
        targetY = ((ev.clientY - rect.top) / rect.height) * vbH;
      }

      hero.addEventListener('pointermove', (ev) => {
        active = true;
        setTargetFromEvent(ev);
      });
      hero.addEventListener('pointerleave', () => {
        // Park off-screen on leave so the pool fades out smoothly via lerp
        targetX = -400;
        targetY = -400;
      });

      // requestAnimationFrame lerp for smooth tracking. The pool eases toward
      // its target each frame; per-event CSS transitions felt jumpy because
      // they kept resetting on every pointermove. Lerp gives a continuous spring.
      const easing = 0.28;
      function loop() {
        currentX += (targetX - currentX) * easing;
        currentY += (targetY - currentY) * easing;
        pool.setAttribute('cx', String(currentX));
        pool.setAttribute('cy', String(currentY));
        requestAnimationFrame(loop);
      }
      // Respect reduced-motion preference — skip the lerp entirely
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        hero.addEventListener('pointermove', (ev) => {
          setTargetFromEvent(ev);
          pool.setAttribute('cx', String(targetX));
          pool.setAttribute('cy', String(targetY));
        });
      } else {
        requestAnimationFrame(loop);
      }
    });
  })();
</script>
