---
// Agent symbol: rune (cluster: communication)
---
<svg viewBox="0 0 128 128" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="symbol-rune-title" stroke="var(--ink)" fill="none">
  <title id="symbol-rune-title">Rune symbol — an outlined three-by-three grid with a citron dot in the center cell. Rigorous, accountable, bound.</title>
  <!-- Outer bound -->
  <rect x="24" y="24" width="72" height="72" stroke-width="2"/>
  <!-- Internal 3×3 division -->
  <g stroke-width="2">
    <line x1="48" y1="24" x2="48" y2="96"/>
    <line x1="72" y1="24" x2="72" y2="96"/>
    <line x1="24" y1="48" x2="96" y2="48"/>
    <line x1="24" y1="72" x2="96" y2="72"/>
  </g>
  <!-- Accent: dot in center cell -->
  <circle cx="60" cy="60" r="4" fill="var(--c)" stroke="none"/>
</svg>
