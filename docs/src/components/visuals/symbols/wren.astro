---
// Agent symbol: wren (cluster: systems)
---
<svg viewBox="0 0 128 128" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="symbol-wren-title" stroke="var(--ink)">
  <title id="symbol-wren-title">Wren symbol — two parallel horizontal rails with three black ties between them and a teal vertical accent floating between the rails without touching. Traversing, sequential, dual-aware.</title>
  <!-- Upper register -->
  <line x1="24" y1="48" x2="104" y2="48" stroke-width="3"/>
  <!-- Lower register -->
  <line x1="24" y1="80" x2="104" y2="80" stroke-width="3"/>
  <!-- Black ties — extend fully between rails (same color, no contact issue) -->
  <g stroke-width="1.5">
    <line x1="40" y1="48" x2="40" y2="80"/>
    <line x1="56" y1="48" x2="56" y2="80"/>
    <line x1="88" y1="48" x2="88" y2="80"/>
  </g>
  <!-- Accent: colored marker sits clearly between rails, not touching either -->
  <line x1="72" y1="56" x2="72" y2="72" stroke="var(--c)" stroke-width="3"/>
</svg>
