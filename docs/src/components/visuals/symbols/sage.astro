---
// Agent symbol: sage (cluster: strategy)
---
<svg viewBox="0 0 128 128" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="symbol-sage-title" stroke="var(--ink)">
  <title id="symbol-sage-title">Sage symbol — an eight-ray asterisk burst radiating from an indigo origin dot, with clear breathing room between the center and the rays. Associative, unbounded, recursive.</title>
  <!-- 8 rays radiating outward from an offset origin (gap around center dot) -->
  <g stroke-width="3">
    <!-- Cardinals — start 12 from center, end at canvas edges -->
    <line x1="64" y1="52" x2="64"  y2="16"/>
    <line x1="76" y1="64" x2="112" y2="64"/>
    <line x1="64" y1="76" x2="64"  y2="112"/>
    <line x1="52" y1="64" x2="16"  y2="64"/>
    <!-- Diagonals — start offset (8,8) from center -->
    <line x1="72" y1="56" x2="96"  y2="32"/>
    <line x1="72" y1="72" x2="96"  y2="96"/>
    <line x1="56" y1="72" x2="32"  y2="96"/>
    <line x1="56" y1="56" x2="32"  y2="32"/>
  </g>
  <!-- Accent: colored origin — clearly visible with breathing room -->
  <circle cx="64" cy="64" r="4" fill="var(--c)" stroke="none"/>
</svg>
