---
// Intent meta-score — the brand mark for the system itself.
// A central frame (the practice — /intent itself) with 17 terminals around
// it (the discipline skills), each in its cluster color. Hover a terminal
// to reveal that skill's name and shape, with a vector connecting it to
// the frame. The foundation skill lives at the center, not on the ring.

import { loadSkills } from '../../lib/skills';

const skills = loadSkills();

// Ring order: 3 strategy → 6 systems → 4 quality → 4 communication,
// starting at the top and going clockwise. /intent is excluded — the
// central frame is its representation.
const CLUSTER_ORDER = ['strategy', 'systems', 'quality', 'communication'] as const;
const ring = CLUSTER_ORDER.flatMap((cluster) =>
  skills.filter((s) => s.cluster === cluster && s.slug !== 'intent'),
);

if (ring.length !== 17) {
  throw new Error(
    `IntentMetaScore expects exactly 17 ring skills (all skills except intent), got ${ring.length}. ` +
    `Check SKILL_CLUSTERS in lib/skills.ts.`,
  );
}

// 17 positions on a circle of radius 320 centered at (400, 400),
// starting at top (-90°), clockwise. Endpoint coords (ex,ey) sit on an
// inner circle of radius 240 — outside the frame, so on-hover vectors
// stay clear of the black frame stroke.
const POSITIONS = [
  { x: 400, y:  80, ex: 400, ey: 160 },  // 0  investigate
  { x: 516, y: 102, ex: 487, ey: 176 },  // 1  strategize
  { x: 616, y: 164, ex: 562, ey: 223 },  // 2  philosopher
  { x: 686, y: 257, ex: 615, ey: 293 },  // 3  blueprint
  { x: 719, y: 370, ex: 639, ey: 378 },  // 4  journey
  { x: 708, y: 488, ex: 631, ey: 466 },  // 5  organize
  { x: 655, y: 593, ex: 592, ey: 545 },  // 6  wireframe
  { x: 568, y: 672, ex: 526, ey: 604 },  // 7  localize
  { x: 459, y: 715, ex: 444, ey: 636 },  // 8  transpose
  { x: 341, y: 715, ex: 356, ey: 636 },  // 9  evaluate
  { x: 232, y: 672, ex: 274, ey: 604 },  // 10 fortify
  { x: 145, y: 593, ex: 208, ey: 545 },  // 11 include
  { x:  92, y: 488, ex: 169, ey: 466 },  // 12 measure
  { x:  81, y: 370, ex: 161, ey: 378 },  // 13 articulate
  { x: 114, y: 257, ex: 185, ey: 293 },  // 14 storytelling
  { x: 184, y: 164, ex: 238, ey: 223 },  // 15 present
  { x: 284, y: 102, ex: 313, ey: 176 },  // 16 specify
];

const terminals = ring.map((skill, i) => ({ ...skill, pos: POSITIONS[i] }));

const raw = import.meta.env.BASE_URL;
const base = raw.endsWith('/') ? raw : raw + '/';
---

<figure class="intent-meta">
  <svg
    class="intent-meta__svg"
    viewBox="0 0 800 800"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-labelledby="intent-meta-title intent-meta-desc"
  >
    <title id="intent-meta-title">Intent — the system at a glance</title>
    <desc id="intent-meta-desc">
      A central frame representing the practice, surrounded by sixteen
      terminal points — one for each discipline skill, colored by cluster.
      Hover a terminal to reveal the skill it stands for.
    </desc>

    <!-- The practice: central frame -->
    <rect
      class="intent-meta__frame"
      x="280" y="320" width="240" height="160"
      fill="none"
      stroke="var(--ink)"
      stroke-width="2.5"
    />

    <!-- 17 terminals — each is an anchor that links to its skill -->
    <g class="intent-meta__terminals">
      {terminals.map((t) => (
        <a
          class="intent-meta__terminal"
          href={`${base}skills/#${t.slug}`}
          data-cluster={t.cluster}
          data-slug={t.slug}
          data-shape={t.shape}
          aria-label={`/${t.slug} — ${t.shape}`}
        >
          <line
            class="intent-meta__vector"
            x1={t.pos.x} y1={t.pos.y}
            x2={t.pos.ex} y2={t.pos.ey}
            stroke="var(--c)"
            stroke-width="2"
          />
          <circle
            class="intent-meta__dot"
            cx={t.pos.x} cy={t.pos.y}
            r="8"
            fill="var(--c)"
            stroke="none"
          />
          <!-- Larger transparent hit target for easier hover/click -->
          <circle
            class="intent-meta__hit"
            cx={t.pos.x} cy={t.pos.y}
            r="24"
            fill="transparent"
          />
        </a>
      ))}
    </g>
  </svg>

  <figcaption class="intent-meta__caption" aria-live="polite">
    <span class="intent-meta__caption-slug mono"></span>
    <span class="intent-meta__caption-shape"></span>
    <span class="intent-meta__caption-hint muted">
      Hover any terminal to read a skill.
    </span>
  </figcaption>
</figure>

<script is:inline>
  (function() {
    const root = document.currentScript && document.currentScript.previousElementSibling;
    // Re-resolve robustly: find the most-recently-rendered .intent-meta
    const fig = document.querySelector('.intent-meta');
    if (!fig) return;
    const slugEl = fig.querySelector('.intent-meta__caption-slug');
    const shapeEl = fig.querySelector('.intent-meta__caption-shape');
    const hintEl = fig.querySelector('.intent-meta__caption-hint');
    const terminals = fig.querySelectorAll('.intent-meta__terminal');

    function show(a) {
      slugEl.textContent = '/' + a.dataset.slug;
      shapeEl.textContent = a.dataset.shape;
      hintEl.style.display = 'none';
    }
    function clear() {
      slugEl.textContent = '';
      shapeEl.textContent = '';
      hintEl.style.display = '';
    }

    terminals.forEach((a) => {
      a.addEventListener('mouseenter', () => show(a));
      a.addEventListener('focus', () => show(a));
      a.addEventListener('mouseleave', clear);
      a.addEventListener('blur', clear);
    });
  })();
</script>
