---
// Skill score: wireframe (cluster: systems)
---
<svg viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="score-wireframe-title" stroke="var(--ink)" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <title id="score-wireframe-title">Wireframe score — a single screen frame crossed by a heavy partition vector; behind its terminal, clean orthogonal zone divisions with registration points; ahead of it, an unresolved field of faint marks awaiting structure. A screen resolved into zones — structure before surface.</title>
  <!-- The screen (structural) -->
  <rect x="160" y="120" width="880" height="560" stroke-width="2.5"/>
  <!-- Resolved zone divisions behind the front (structural, hairline) -->
  <g stroke-width="1.5">
    <line x1="440" y1="120" x2="440" y2="400"/>
    <line x1="160" y1="560" x2="680" y2="560"/>
  </g>
  <line x1="360" y1="560" x2="360" y2="680" stroke-width="1"/>
  <!-- ACTIVE: the partition vector — resolution sweeping rightward -->
  <line x1="160" y1="400" x2="680" y2="400" stroke="var(--c)" stroke-width="5"/>
  <!-- ACTIVE: the resolution front -->
  <circle cx="680" cy="400" r="10" fill="var(--c)" stroke="none"/>
  <!-- ACTIVE: registration points where divisions commit -->
  <g fill="var(--c)" stroke="none">
    <circle cx="440" cy="400" r="5"/>
    <circle cx="360" cy="560" r="4"/>
  </g>
  <!-- Unresolved field ahead of the front (faint, awaiting structure) -->
  <g fill="var(--ink)" opacity="0.55" stroke="none">
    <circle cx="760" cy="200" r="2"/>
    <circle cx="840" cy="160" r="2.5"/>
    <circle cx="920" cy="240" r="2"/>
    <circle cx="880" cy="320" r="2"/>
    <circle cx="800" cy="280" r="2.5"/>
    <circle cx="960" cy="360" r="2"/>
    <circle cx="760" cy="480" r="2"/>
    <circle cx="880" cy="440" r="2.5"/>
    <circle cx="800" cy="560" r="2"/>
    <circle cx="920" cy="520" r="2"/>
    <circle cx="960" cy="620" r="2.5"/>
    <circle cx="840" cy="640" r="2"/>
  </g>
</svg>
