---
// Skill score: measure (cluster: quality)
---
<svg viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="score-measure-title" stroke="var(--ink)" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <title id="score-measure-title">Measure score — an outer test territory containing variants A and B stacked vertically, horizontal vectors converging right to a vertical threshold with an aperture, and a sparse field of metric outcomes scattered below. Comparison made structural, judgment held at the aperture.</title>
  <!-- Outer test territory (structural) -->
  <rect x="60" y="60" width="1080" height="480" stroke-width="2.5"/>
  <!-- Variants stacked vertically — A above, B below — so vectors don't cross frames -->
  <rect x="120" y="100" width="320" height="160" stroke-width="1.5"/>
  <rect x="120" y="320" width="320" height="160" stroke-width="1.5"/>
  <!-- ACTIVE: Variant A composition -->
  <g fill="var(--c)" stroke="none">
    <circle cx="180" cy="148" r="4"/>
    <circle cx="260" cy="172" r="5"/>
    <circle cx="340" cy="148" r="4"/>
    <circle cx="220" cy="216" r="3"/>
    <circle cx="360" cy="220" r="4"/>
  </g>
  <g stroke="var(--c)" stroke-width="1">
    <line x1="180" y1="148" x2="260" y2="172"/>
    <line x1="260" y1="172" x2="340" y2="148"/>
    <line x1="220" y1="216" x2="360" y2="220"/>
  </g>
  <!-- ACTIVE: Variant B composition -->
  <g fill="var(--c)" stroke="none">
    <circle cx="180" cy="368" r="3"/>
    <circle cx="240" cy="392" r="4"/>
    <circle cx="320" cy="372" r="5"/>
    <circle cx="200" cy="436" r="4"/>
    <circle cx="300" cy="448" r="4"/>
    <circle cx="380" cy="404" r="3"/>
  </g>
  <g stroke="var(--c)" stroke-width="1">
    <line x1="180" y1="368" x2="240" y2="392"/>
    <line x1="240" y1="392" x2="320" y2="372"/>
    <line x1="320" y1="372" x2="380" y2="404"/>
    <line x1="200" y1="436" x2="300" y2="448"/>
  </g>
  <!-- ACTIVE: horizontal vectors from each variant to the comparison threshold -->
  <g stroke="var(--c)" stroke-width="2.5">
    <line x1="440" y1="180" x2="860" y2="200"/>
    <line x1="440" y1="400" x2="860" y2="380"/>
  </g>
  <!-- Vertical comparison threshold with aperture (the place of judgment) -->
  <g stroke-width="3.5">
    <line x1="860" y1="80"  x2="860" y2="260"/>
    <line x1="860" y1="320" x2="860" y2="520"/>
  </g>
  <!-- ACTIVE: metric outcomes — sparse field below the test territory, no connectors -->
  <g fill="var(--c)" stroke="none">
    <circle cx="160"  cy="640" r="4"/>
    <circle cx="280"  cy="680" r="3"/>
    <circle cx="400"  cy="616" r="5"/>
    <circle cx="520"  cy="664" r="4"/>
    <circle cx="640"  cy="640" r="3"/>
    <circle cx="760"  cy="624" r="4"/>
    <circle cx="880"  cy="680" r="3"/>
    <circle cx="1000" cy="640" r="4"/>
  </g>
</svg>
