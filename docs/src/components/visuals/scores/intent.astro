    <circle cx="600"  cy="88"  r="6"/>
    <circle cx="1000" cy="128" r="6"/>
    <circle cx="1080" cy="704" r="6"/>
    <circle cx="600"  cy="728" r="6"/>
    <circle cx="120"  cy="704" r="6"/>
