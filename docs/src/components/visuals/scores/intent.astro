  <g fill="var(--ink)" opacity="0.6" stroke="none">
    <circle cx="488" cy="320" r="2"/>
    <circle cx="568" cy="356" r="2"/>
    <circle cx="640" cy="328" r="2"/>
    <circle cx="712" cy="368" r="2"/>
    <circle cx="496" cy="432" r="2"/>
    <circle cx="576" cy="460" r="2"/>
    <circle cx="660" cy="476" r="2"/>
    <circle cx="712" cy="464" r="2"/>
  </g>
  <!-- ACTIVE: 6 radiating vectors from frame center (600, 400) to outer terminal points -->
  <g stroke="var(--c)" stroke-width="2">
    <line x1="600" y1="400" x2="200" y2="128"/>
    <line x1="600" y1="400" x2="600" y2="88"/>
    <line x1="600" y1="400" x2="1000" y2="128"/>
