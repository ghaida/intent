---
// Skill score: philosopher (cluster: strategy)
---
<svg viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="score-philosopher-title" stroke="var(--ink)" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <title id="score-philosopher-title">Philosopher score — a center point radiating twelve straight rays at 30° intervals of varied lengths, surrounded by a corona of associative dots. Openness — the suspension of frame.</title>
  <!-- ACTIVE: center point -->
  <circle cx="600" cy="400" r="8" fill="var(--c)" stroke="none"/>
  <!-- ACTIVE: 12 straight rays at exact 30° intervals, varied lengths -->
  <g stroke="var(--c)" stroke-width="1.5">
    <!-- 0° (E) — long -->
    <line x1="600" y1="400" x2="1080" y2="400"/>
    <!-- 30° (ENE) — medium -->
    <line x1="600" y1="400" x2="912"  y2="220"/>
    <!-- 60° (NE) — short -->
    <line x1="600" y1="400" x2="720"  y2="192"/>
    <!-- 90° (N) — medium -->
    <line x1="600" y1="400" x2="600"  y2="80"/>
    <!-- 120° (NW) — short -->
    <line x1="600" y1="400" x2="480"  y2="192"/>
    <!-- 150° (WNW) — medium -->
    <line x1="600" y1="400" x2="288"  y2="220"/>
    <!-- 180° (W) — long -->
    <line x1="600" y1="400" x2="120"  y2="400"/>
    <!-- 210° (WSW) — medium -->
    <line x1="600" y1="400" x2="288"  y2="580"/>
    <!-- 240° (SW) — short -->
    <line x1="600" y1="400" x2="480"  y2="608"/>
    <!-- 270° (S) — medium -->
    <line x1="600" y1="400" x2="600"  y2="720"/>
    <!-- 300° (SE) — short -->
    <line x1="600" y1="400" x2="720"  y2="608"/>
    <!-- 330° (ESE) — medium -->
    <line x1="600" y1="400" x2="912"  y2="580"/>
  </g>
  <!-- Associative field — regular 160px corona pattern, avoiding the radiating zone -->
  <g fill="var(--ink)" opacity="0.55" stroke="none">
    <!-- Top row -->
    <circle cx="80"   cy="80"  r="2"/>
    <circle cx="240"  cy="80"  r="2"/>
    <circle cx="400"  cy="80"  r="2"/>
    <circle cx="800"  cy="80"  r="2"/>
    <circle cx="960"  cy="80"  r="2"/>
    <circle cx="1120" cy="80"  r="2"/>
    <!-- Upper-mid (outside radiation zone) -->
    <circle cx="80"   cy="240" r="2"/>
    <circle cx="1120" cy="240" r="2"/>
    <circle cx="160"  cy="160" r="2"/>
    <circle cx="1040" cy="160" r="2"/>
    <!-- Mid edges -->
    <circle cx="80"   cy="400" r="2"/>
    <circle cx="1120" cy="400" r="2"/>
    <!-- Lower-mid (outside radiation zone) -->
    <circle cx="80"   cy="560" r="2"/>
    <circle cx="1120" cy="560" r="2"/>
    <circle cx="160"  cy="640" r="2"/>
    <circle cx="1040" cy="640" r="2"/>
    <!-- Bottom row -->
    <circle cx="80"   cy="720" r="2"/>
    <circle cx="240"  cy="720" r="2"/>
    <circle cx="400"  cy="720" r="2"/>
    <circle cx="800"  cy="720" r="2"/>
    <circle cx="960"  cy="720" r="2"/>
    <circle cx="1120" cy="720" r="2"/>
  </g>
</svg>
