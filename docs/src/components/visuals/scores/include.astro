---
// Skill score: include (cluster: quality)
---
<svg viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="score-include-title" stroke="var(--ink)" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <title id="score-include-title">Include score — a small central design reaching outward along eight lines to perpendicular access thresholds at terminal points around the perimeter, with a wide field of human variability dots beneath. A single design extending its reach across human difference.</title>
  <!-- Central design (structural) on 4-grid: (520, 352) 160×96 -->
  <rect x="520" y="352" width="160" height="96" stroke-width="2.5"/>
  <g fill="var(--ink)" opacity="0.8" stroke="none">
    <circle cx="560" cy="380" r="3"/>
    <circle cx="608" cy="396" r="4"/>
    <circle cx="660" cy="420" r="3"/>
  </g>
  <g stroke-width="1" opacity="0.7">
    <line x1="560" y1="380" x2="608" y2="396"/>
    <line x1="608" y1="396" x2="660" y2="420"/>
  </g>
  <!-- ACTIVE: lines reaching outward, all endpoints 4-aligned -->
  <g stroke="var(--c)" stroke-width="1.5">
    <line x1="600" y1="352" x2="600" y2="160"/>
    <line x1="680" y1="380" x2="900" y2="200"/>
    <line x1="680" y1="400" x2="1080" y2="400"/>
    <line x1="680" y1="428" x2="900" y2="600"/>
    <line x1="600" y1="448" x2="600" y2="640"/>
    <line x1="520" y1="428" x2="300" y2="600"/>
    <line x1="520" y1="400" x2="120" y2="400"/>
    <line x1="520" y1="380" x2="300" y2="200"/>
  </g>
  <!-- ACTIVE: thresholds — perpendicular bars at each line's endpoint -->
  <!-- Cardinals: simple H/V bars. Diagonals: rotated 90° to true perpendicular. -->
  <g stroke="var(--c)" stroke-width="3">
    <!-- N -->
    <line x1="580" y1="160" x2="620" y2="160"/>
    <!-- NE — line dir (220,-180), perpendicular bar -->
    <line x1="890" y1="188" x2="910" y2="212"/>
    <!-- E -->
    <line x1="1080" y1="380" x2="1080" y2="420"/>
    <!-- SE — line dir (220, 172), perpendicular bar -->
    <line x1="910" y1="588" x2="890" y2="612"/>
    <!-- S -->
    <line x1="580" y1="640" x2="620" y2="640"/>
    <!-- SW — line dir (-220, 172), perpendicular bar -->
    <line x1="290" y1="588" x2="310" y2="612"/>
    <!-- W -->
    <line x1="120" y1="380" x2="120" y2="420"/>
    <!-- NW — line dir (-220,-180), perpendicular bar -->
    <line x1="310" y1="188" x2="290" y2="212"/>
  </g>
  <!-- ACTIVE: terminal points — modes of access — all 4-aligned -->
  <g fill="var(--c)" stroke="none">
    <circle cx="600"  cy="120" r="6"/>
    <circle cx="928"  cy="180" r="6"/>
    <circle cx="1120" cy="400" r="6"/>
    <circle cx="928"  cy="620" r="6"/>
    <circle cx="600"  cy="680" r="6"/>
    <circle cx="272"  cy="620" r="6"/>
    <circle cx="80"   cy="400" r="6"/>
    <circle cx="272"  cy="180" r="6"/>
  </g>
  <!-- Variability field (structural) on 4-grid -->
  <g fill="var(--ink)" opacity="0.5" stroke="none">
    <circle cx="120"  cy="720" r="2"/>
    <circle cx="240"  cy="740" r="2"/>
    <circle cx="380"  cy="708" r="2"/>
    <circle cx="500"  cy="728" r="2"/>
    <circle cx="600"  cy="748" r="2"/>
    <circle cx="720"  cy="708" r="2"/>
    <circle cx="848"  cy="728" r="2"/>
    <circle cx="980"  cy="720" r="2"/>
    <circle cx="1100" cy="740" r="2"/>
  </g>
</svg>
